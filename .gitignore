# Dependencies
node_modules
.pnp
.pnp.js

# This repo uses pnpm — only the root pnpm-lock.yaml is tracked.
# Block npm/yarn lockfiles and any nested pnpm lockfile from sneaking back in.
package-lock.json
yarn.lock
apps/*/pnpm-lock.yaml
packages/*/pnpm-lock.yaml

# Build outputs
.next
dist
build
out

# Turbo
.turbo

# Environment — NEVER commit these
.env
.env.local
.env.*.local
!.env.example

# Payload
src/payload-types.ts
apps/*/src/payload-types.ts
apps/*/public/media

# OS
.DS_Store
Thumbs.db

# Editors
.vscode
.idea
*.swp
*.swo

# Expo / React Native
.expo
ios
android
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build
expo-env.d.ts

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.vercel
.npmrc
