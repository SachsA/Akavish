# Dependencies
node_modules
.pnp
.pnp.js

# This repo uses pnpm — only the root pnpm-lock.yaml is tracked.
# Block npm/yarn lockfiles and any nested pnpm lockfile from sneaking back in.
package-lock.json
yarn.lock
apps/*/pnpm-lock.yaml
packages/*/pnpm-lock.yaml

# Build outputs
.next
dist
build
out
*.tsbuildinfo

# Turbo
.turbo

# Environment — NEVER commit these
.env
.env.local
.env.*.local
!.env.example

# GitHub token the assistant reads to push and check CI — never commit it.
.github-token
# State file of Claude's scheduled maintenance task (local bookkeeping).
.claude-maintenance.json
# Files the Claude desktop app saves into the folder (screenshots, exports).
/Claude outputs/

# Database dumps — a full copy of production (emails, password hashes). The
# usual `git add -A` would publish one downloaded here for a restore.
*.dump
*.sql.gz
*.backup

# Sentry — the CLI/wizard writes the auth token here. Ignored pre-emptively so
# it can never be committed, even if someone runs `npx @sentry/wizard` later.
.env.sentry-build-plugin
.sentryclirc

# Payload
src/payload-types.ts
apps/*/src/payload-types.ts
apps/*/public/media

# OS
.DS_Store
Thumbs.db

# Editors
.vscode
.idea
*.swp
*.swo

# Expo / React Native
.expo
ios
android
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build
expo-env.d.ts

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.vercel
.npmrc

# Login of the CMS user Claude uses to post articles (never committed)
.cms-import
# Images and Markdown for scripts/publish-articles.mjs (publisher assets, not ours to commit)
import-images/
# Alex's own source documents (old conference PDFs), local only
import-docs/
