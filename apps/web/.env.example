# NOTE: the web app never talks to the database directly — it reads everything
# from the CMS over HTTP (CMS_URL). Only the CMS needs DATABASE_URL.

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Media (Cloudflare R2) — the web app never uploads.
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.akavish.gg

# Search (Meilisearch) — used server-side only by /api/search (never exposed).
# OPTIONAL. Leave MEILISEARCH_HOST empty and /api/search falls back to querying
# the CMS (Postgres ILIKE on title + excerpt) — search still works, it just
# loses typo tolerance and relevance ranking.
MEILISEARCH_HOST=http://localhost:7700
# Search-only key (recommended). Falls back to MEILISEARCH_API_KEY if unset.
MEILISEARCH_SEARCH_KEY=
# Master/admin key — only needed if you don't set a search-only key above.
MEILISEARCH_API_KEY=

# Error monitoring (Sentry) — OPTIONAL.
# Leave NEXT_PUBLIC_SENTRY_DSN empty and Sentry is a no-op: no reporting, no
# extra network calls, and `pnpm build` works with no Sentry account.
NEXT_PUBLIC_SENTRY_DSN=
# Labels events in the Sentry UI. Defaults to NODE_ENV.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Build-time only, for uploading source maps so stack traces are readable.
# Without them the build still succeeds, it just skips the upload.
# SENTRY_AUTH_TOKEN is a SECRET — never commit it, set it in Vercel/CI.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public/canonical base URL — used for SEO (sitemap, robots, canonical, OG).
# In production set this to https://akavish.gg. Falls back to NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CMS (standalone Payload — REST API source for articles)
CMS_URL=http://localhost:3001

# Instant refresh — OPTIONAL. The CMS calls POST /api/revalidate after a public
# change, with this secret in `x-revalidate-secret`; the site then drops its
# cached CMS reads at once. SECRET, the SAME value as REVALIDATE_SECRET on the
# CMS (`openssl rand -hex 32`). Empty → the route answers 404 and pages refresh
# on their 30 s ISR timer only.
REVALIDATE_SECRET=

# Reader accounts — saved articles and the reader's role badge. The web calls
# the CMS's /api/reader-api/* server to server with this secret (after checking
# the Clerk session). SECRET, the SAME value as READER_API_SECRET on the CMS
# (`openssl rand -hex 32`). Empty → "Save" and /account say saving is
# unavailable; everything else works.
READER_API_SECRET=
