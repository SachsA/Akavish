# NOTE: the web app never talks to the database directly — it reads everything
# from the CMS over HTTP (CMS_URL). Only the CMS needs DATABASE_URL.

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=akavish-media
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.akavish.gg

# Search (Meilisearch) — used server-side only by /api/search (never exposed).
MEILISEARCH_HOST=http://localhost:7700
# Search-only key (recommended). Falls back to MEILISEARCH_API_KEY if unset.
MEILISEARCH_SEARCH_KEY=
# Master/admin key — only needed if you don't set a search-only key above.
MEILISEARCH_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public/canonical base URL — used for SEO (sitemap, robots, canonical, OG).
# In production set this to https://akavish.gg. Falls back to NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CMS (standalone Payload — REST API source for articles)
CMS_URL=http://localhost:3001
