# Database — PostgreSQL.
# Local dev: the Postgres from docker-compose.yml (`docker compose up -d` at the
# repo root) — this default works as-is. Production uses Neon and its URL lives
# only in Railway's variables, never in a local .env.
DATABASE_URL=postgresql://akavish:akavish@localhost:5432/akavish

# Payload secret — used to sign cookies/tokens. Generate a long random string.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# `pnpm seed` (local only) — the admin it creates on an EMPTY database.
# Optional: defaults to admin@akavish.test / akavish-local.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# URLs (optional — sensible defaults are used if omitted)
# Public URL the CMS is served from (admin + REST API). CMS runs on port 3001.
SERVER_URL=http://localhost:3001
# The web frontend origin allowed for CORS / CSRF (browser/mobile clients).
WEB_URL=http://localhost:3000

# Search (Meilisearch) — the CMS indexes published articles here on change.
# Needs the master/admin key (write access). Leave MEILISEARCH_HOST empty to
# disable indexing entirely (editing still works, and the web app falls back to
# searching the CMS directly — see apps/web/.env.example).
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=akavish_dev_master_key

# Error monitoring (Sentry) — OPTIONAL, server-side only (no browser SDK here).
# Leave SENTRY_DSN empty and Sentry is a no-op. Use a SEPARATE Sentry project
# from the web app so CMS incidents don't drown in frontend noise.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Build-time only, for source map upload. SENTRY_AUTH_TOKEN is a SECRET.
SENTRY_ORG=
SENTRY_PROJECT_CMS=
SENTRY_AUTH_TOKEN=

# Transactional email — Resend (password resets, account verification).
# Leave RESEND_API_KEY empty to fall back to Payload's console adapter: emails
# are printed to the terminal instead of sent (fine locally, NOT for production —
# without it a forgotten admin password cannot be reset).
# The from-address domain must be verified in Resend or sends are rejected.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@mail.akavish.gg
EMAIL_FROM_NAME=Akavish

# Media storage — Cloudflare R2 (S3-compatible API).
# The CMS is what uploads/serves media, so these live here (not on the web app).
# Leave R2_BUCKET empty to fall back to local disk storage (fine for local dev,
# NOT for production: Railway's filesystem is ephemeral and files vanish on
# redeploy). Set the same values in dev and prod so the DB schema stays in sync.
R2_BUCKET=akavish-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# S3 API endpoint from the Cloudflare dashboard — for uploads only.
R2_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com
# Public URL that actually serves the files: the bucket's custom domain (prod:
# https://media.akavish.gg) or, for a quick test, its r2.dev subdomain.
R2_PUBLIC_URL=https://media.akavish.gg

# AI scout (src/scout/, DEPLOYMENT.md §11). OFF unless SCOUT_ENABLED=true, so a
# fresh clone never collects anything or spends money. Locally, `pnpm scout:run`
# runs it once in dry run without any of these.
SCOUT_ENABLED=
# Secret. Unset → dry run: no AI call, each item becomes its own story.
ANTHROPIC_API_KEY=
# Private Discord channel's webhook. Unset → digests are only logged.
SCOUT_DISCORD_WEBHOOK_URL=
# Optional caps in USD (defaults 50 a month, 5 a day) and model.
# SCOUT_MONTHLY_BUDGET_USD=50
# SCOUT_DAILY_BUDGET_USD=5
# SCOUT_TRIAGE_MODEL=claude-haiku-5-5
# SCOUT_DRAFT_MODEL=claude-sonnet-5-5
# SCOUT_DRY_RUN=true
# Step 2, Discord bot (Publish / Edit / Reject buttons). All five or none:
# without them, drafts are announced through the webhook, without buttons.
# The token is a secret; the rest come from the Discord developer portal and
# the channel (Developer Mode → right-click → Copy ID).
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
SCOUT_DISCORD_CHANNEL_ID=
# Your own Discord user ID: only your clicks are accepted.
SCOUT_DISCORD_OWNER_ID=

# Instant site refresh — OPTIONAL. After a public change (article published,
# edited or removed, game, tag, author) the CMS pings WEB_URL/api/revalidate
# so new articles show at once instead of within ~30 s and a few reloads.
# SECRET, the SAME value as REVALIDATE_SECRET on the web app
# (`openssl rand -hex 32`). Empty → no ping, the site's 30 s cache still works.
REVALIDATE_SECRET=
