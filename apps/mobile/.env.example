# The mobile app reads articles straight from the CMS (Payload REST API),
# the same backend the web uses. Point this at the CMS, not the web.
#
# ⚠️ On a phone (Expo Go), `localhost` is the PHONE, not your computer — the app
# can't reach a CMS running on your Mac that way. Use one of:
#   - https://cms.akavish.gg            production CMS (public, read-only API)
#   - http://<your-mac-LAN-IP>:3001     local CMS, phone on the same Wi-Fi
#     (find the IP with: ipconfig getifaddr en0)
# `localhost` only works in an iOS simulator running on the same Mac.
EXPO_PUBLIC_CMS_URL=https://cms.akavish.gg
