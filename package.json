{
  "name": "akavish",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint --filter=!@akavish/mobile",
    "type-check": "turbo run type-check --filter=!@akavish/mobile",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "bash scripts/clean.sh",
    "reset:db": "bash scripts/reset-db.sh"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
